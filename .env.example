# ============================================================================
# Trader configuration. Copy to `.env` and fill in as you reach each phase.
# Phase 1 (the pure-logic core + demo dashboard) needs NONE of the API keys.
# ============================================================================

# ---- Phase 1: app + pure logic (no external keys required) ----
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./trader.db
TOTAL_BUDGET_GBP=300
BUYING_CAPITAL_CURRENCY=GBP
SOLDPRICE_PROVIDER=fixture          # fixture (offline) | rapidapi_ecommet (Phase 3)
ALERT_CHANNEL=console               # console (dev) | telegram (Phase 4)

# ---- Phase 2: eBay Browse API (FINDING active UK listings) ----
# OAuth2 client-credentials grant. Create keys at developer.ebay.com.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox                    # sandbox | production
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_OAUTH_BASE=https://api.ebay.com/identity/v1/oauth2/token
EBAY_BROWSE_BASE=https://api.ebay.com/buy/browse/v1
EBAY_DAILY_CALL_BUDGET=4500         # stay under the ~5000/day app quota
EBAY_TCG_CATEGORY_IDS=              # comma-separated GB category ids (e.g. Pokémon Individual Cards)
# Whole-category "scour" sweeps need eBay Buy API full access (Application Growth Check).
# A standard keyset can still do keyword card searches, so leave this false to scan by
# card name today; set true once eBay grants your keyset full Buy API access.
EBAY_BUY_API_FULL_ACCESS=false

# ---- Phase 3: sold-price valuation provider (eBay UK sold prices) ----
RAPIDAPI_KEY=
RAPIDAPI_SOLDPRICE_HOST=ebay-average-selling-price.p.rapidapi.com
SOLDPRICE_SITE_ID=3                 # 3 = eBay UK (GBP)
VALUATION_TTL_HOURS=72
# Optional USD cross-check (FX-adjusted) — layered in later:
PRICECHARTING_API_KEY=
USD_GBP_FX_RATE=                    # optional manual override; else a live source later

# ---- Phase 4: persistence + scheduled auto-scans + alerts ----
DATABASE_URL=sqlite:///./trader.db
SCAN_INTERVAL_MIN=0                  # 0 = off; e.g. 10 = scour + alert every 10 min
ALERT_CHANNEL=console               # console | telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
